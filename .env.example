# Optional local settings (no AWS connections). This file is a reference;
# export values in your shell if you want to override defaults.
# Relative paths resolve from the extracted project folder.
MARKETINTEL_DATA_DIR=storage
# Set to the directory of an already installed/local sentence-transformer model:
# MARKETINTEL_LOCAL_EMBED_MODEL=models/local-embedding-model
# A locally running Ollama model is optional for AI-generated answers:
# MARKETINTEL_OLLAMA_MODEL=locally-installed-model-name

# Local-only application server defaults (do not use public bind without auth):
MARKETINTEL_BIND=127.0.0.1
MARKETINTEL_PORT=7860
# Local retrieval modes: tfidf (default), semantic (requires local model)
MARKETINTEL_RETRIEVAL_MODE=tfidf
